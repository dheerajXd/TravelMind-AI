# Server environment variables
# Copy this file to .env and fill in your values

# App
PORT=8000
NODE_ENV=development
DEBUG=false

# MongoDB
DATABASE_URL=mongodb://localhost:27017/travel_assistant

# Redis (optional — falls back to in-memory store if not set)
# REDIS_URL=redis://localhost:6379

# Google APIs
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Frontend URL (for CORS allow-list)
FRONTEND_WEB_URL=http://localhost:8082

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Firebase FCM (optional — push notifications disabled if not set)
# FCM_SERVICE_ACCOUNT_PATH=/absolute/path/to/serviceAccountKey.json

# Notification thresholds
NOTIFICATION_SCORE_THRESHOLD=0.6
IDLE_MINUTES_THRESHOLD=10

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
